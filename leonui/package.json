{
  "name": "leonui",
  "version": "0.1.0",
  "description": "Typed UI runtime: HTML is the schema, the element prototypes are the runtime, the browser is the framework.",
  "type": "module",
  "module": "./dist/leonui.js",
  "exports": {
    ".": "./dist/leonui.js",
    "./ui.css": "./src/ui.css"
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outfile ./dist/leonui.js --target=browser --minify",
    "typecheck": "tsc --noEmit",
    "dev": "bun run serve/serve.ts",
    "test": "bun test tests/",
    "bench": "bun run scripts/bench.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "alpinejs": "^3.17.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "latest",
    "vue": "^3.5.43"
  },
  "files": [
    "dist",
    "src",
    "skill",
    "pages",
    "serve",
    "scripts",
    "README.md"
  ]
}